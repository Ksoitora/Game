; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that change here are too many and would make reviewing diffs difficult.
; Instead, use the editor UI to modify existing parameters, and add new ones if missing.
; For reference, see the default project.godot at https://github.com/godotengine/godot/blob/master/editor/project_default.godot

config_version=5

[application]

config/name="Dofus-Like Game"
config/version="0.1.0"
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[debug]

gdscript/warnings/unused_variable=1
gdscript/warnings/unused_argument=1
